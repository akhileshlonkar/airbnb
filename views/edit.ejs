<% layout('boilerplate.ejs') %>



<div class="edit-container">
    <h2 class="form-title">Edit Listing</h2>

    <form action="/listing/<%= a._id %>?_method=PUT" method="POST" class="listing-form">

        <div class="form-group">
            <label>Title</label>
            <input type="text" name="listing[title]" value="<%= a.title %>" required>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea name="listing[description]" rows="4" required><%= a.description %></textarea>
        </div>

        <div class="form-group">
            <label>Image Link</label>
            <input type="text" name="listing[image]" value="<%= a.image %>" required>
        </div>

        <div class="form-row">
            <div class="form-group half">
                <label>Price</label>
                <input type="number" name="listing[price]" value="<%= a.price %>" required>
            </div>

            <div class="form-group half">
                <label>Country</label>
                <input type="text" name="listing[country]" value="<%= a.country %>" required>
            </div>
        </div>

        <div class="form-group">
            <label>Location</label>
            <input type="text" name="listing[location]" value="<%= a.location %>" required>
        </div>

        <button type="submit" class="btn-submit">Update Listing</button>
    </form>
</div>

