<% layout('boilerplate.ejs')-%>
<body>
    <div class="form-wrapper">
    <div class="form-container">
        <h2>Login User</h2>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" placeholder="Add a Username" id="username" required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Add a password" id="password" required>
            </div>
            <button class="submit-btn" type="submit" col="5">Login</button>
        </form>
    </div>
</div>
</body> 