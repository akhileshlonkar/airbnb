<% layout('boilerplate.ejs') %>

<div class="details-container">

    <!-- Image Box -->
    <div class="image-box">
        <img src="<%= a.image %>" alt="<%= a.title %>">
    </div>

    <!-- Info Section -->
    <div class="info-box">
        <h1 class="title"><%= a.title %></h1>

        <p class="description"><%= a.description %></p>

        <div class="info-grid">
            <p><strong>Price:</strong> ₹<%= a.price %>/night</p>
            <p><strong>Location:</strong> <%= a.location %></p>
            <p><strong>Country:</strong> <%= a.country %></p>
        </div>
        <% if (currentUser && currentUser._id.equals(a.owner)) { %>
        <div class="button-row">
            <a href="/listing/edit/<%= a._id %>" class="btn edit">Edit</a>
            <a href="/listing/delete/<%= a._id %>" class="btn delete">Delete</a>
        </div>
        <%}%>
    </div>
</div>
<hr>
<div class="col-8 offset-3" class="form-label">
    <h4>leave a review</h4>
    <form class="form-control" action="/listing/<%= a._id %>/reviews" method="post">
        <div>
            <label for="rating">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-control">
        </div>
        <div>
            <label for="comment" >Comment</label>
            <textarea value="Good" name ="review[comment]"class="form-control"></textarea>
            <br>
        </div class="form-control">
        <button  class="btn btn-dark" action="/listing/<%= a.id %>/revie">submit</button>
        <br><br>
    </form>
</div>


<div>
    <h3>All Reviews</h3>

<div class="reviews-wrapper">
    <% for (let i = 0; i < a.reviews.length; i++) { %>
        <div class="cards-review">
            <h5>user</h5>
            <p><%= a.reviews[i].created.toLocaleString('en-IN', { month: 'long', year: 'numeric' }) %></p>
            <p><%= a.reviews[i].comment %></p>
            <p><%= a.reviews[i].rating %></p>
        </div>
    <% } %>
</div>
</div>
    

















<script>
(() => {
    "use strict";
    const forms = document.querySelectorAll(".needs-validation");
    Array.from(forms).forEach(form => {
        form.addEventListener("submit", event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add("was-validated");
        });
    });
})();
</script>


